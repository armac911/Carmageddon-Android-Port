set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(MIYOO_TOOLCHAIN /opt/mini CACHE PATH "Buildroot Miyoo toolchain")
set(CMAKE_C_COMPILER "${MIYOO_TOOLCHAIN}/bin/arm-linux-gnueabihf-gcc")
set(CMAKE_SYSROOT "${MIYOO_TOOLCHAIN}/arm-buildroot-linux-gnueabihf/sysroot")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_C_FLAGS_INIT "-mcpu=cortex-a7 -mfpu=neon-vfpv4 -mfloat-abi=hard")

set(MIYOO_SDK_LIB_DIR "" CACHE PATH "Mini SDK vendor libraries for link-time resolution")
if(MIYOO_SDK_LIB_DIR)
    set(CMAKE_EXE_LINKER_FLAGS_INIT "-Wl,-rpath-link,${MIYOO_SDK_LIB_DIR} -Wl,-rpath-link,${CMAKE_SYSROOT}/usr/lib")
endif()
